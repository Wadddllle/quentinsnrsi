# Big local data / generated artefacts -- mounted at runtime, never baked in
data/
ssd-data/
onemap_full_scrape/
onemap_landmarks/
*.geojson
*.stl
*.city.json
hdb.json

# Exception: the Dockerfile's `cloud-run` target (see DEPLOY.md) bakes runtime
# data in instead of mounting it, since Cloud Run has no bind-mount concept.
# It reads from this separate staging dir, not `data/` -- a parent directory
# that's excluded above can't be selectively un-excluded, so this has to be a
# directory of its own rather than a `!data/dtm.tif`-style exception.
!cloud_data/**

# Vendored reference repos (own .git, not part of this project's code)
ninja/
onemap-slicer/
buildings.city/
webui/

# Build/venv/editor junk
.venv/
**/node_modules/
**/__pycache__/
**/*.pyc
.git/
.claude/
doc/
*.ipynb
Miniconda3-latest-Linux-x86_64.sh
pcdopenmcshit/
